# Copy to .env and adjust. Never commit the real .env.

# --- Database (consumed by the app; the container itself uses POSTGRES_* below)
DATABASE_URL=postgresql+psycopg://arxiv_rag:arxiv_rag@localhost:5432/arxiv_rag

# Used by the db service in docker-compose.yml.
# Bump both POSTGRES_PORT and the port in DATABASE_URL if something else
# already listens on 5432 (e.g. a native Postgres).
POSTGRES_USER=arxiv_rag
POSTGRES_PASSWORD=arxiv_rag
POSTGRES_DB=arxiv_rag
POSTGRES_PORT=5432

# Host port for the API service in docker-compose.yml
API_PORT=8000

# --- arXiv ingestion (arXiv asks for at most 1 request per 3 seconds)
ARXIV_SLEEP_SECONDS=3
ARXIV_PAGE_SIZE=100
ARXIV_MAX_RETRIES=3

# --- Embeddings (local, via sentence-transformers)
EMBEDDING_MODEL=Alibaba-NLP/gte-modernbert-base
EMBED_DIM=768
EMBED_BATCH_SIZE=32

# --- RAG retrieval / answering
RAG_TOP_K=5
MIN_SCORE=0.25
MAX_CONTEXT_CHARS=12000

# --- LLM (any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, xkiro, ...)
# e.g. xkiro: LLM_BASE_URL=https://api.xkiro.com/v1  LLM_MODEL=google/gemini-3.8-flash
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Logging
LOG_LEVEL=INFO
